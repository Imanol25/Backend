{
  "name": "library-backend",
  "version": "1.0.0",
  "description": "API REST para catálogo de biblioteca — Arquitectura en Capas con Node.js, Express y MySQL",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "docker:dev": "docker compose -f docker/dev/docker-compose.yml up --build",
    "docker:dev:down": "docker compose -f docker/dev/docker-compose.yml down -v",
    "docker:prod": "docker compose -f docker/prod/docker-compose.yml --env-file .env.prod up -d --build",
    "docker:prod:down": "docker compose -f docker/prod/docker-compose.yml down"
  },
  "keywords": ["nodejs", "express", "mysql", "layered-architecture", "rest-api"],
  "author": "library-backend",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

