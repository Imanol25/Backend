# =============================================================================
# .env.example — Plantilla de variables de entorno
#
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales (nunca commitees .env al repositorio)
#   3. Para producción, crea .env.prod con valores seguros
# =============================================================================

# ---- Servidor ----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---- Base de Datos MySQL -----------------------------------------------------
DB_HOST=localhost         # En Docker usa el nombre del servicio: "db"
DB_PORT=3306
DB_NAME=library_db
DB_USER=library_user
DB_PASSWORD=secret
DB_POOL_LIMIT=10

# ---- Solo para docker-compose prod ------------------------------------------
MYSQL_ROOT_PASSWORD=rootsecret_change_me_in_prod

